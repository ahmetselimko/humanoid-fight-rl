      </body>
    </body>
  </worldbody>

  <!-- ─────────────────────────────────────────────── -->
  <!--  Self-collision excludes                        -->
  <!-- ─────────────────────────────────────────────── -->
  <contact>
    <!-- P1 ayak bileği self-collision -->
    <exclude body1="p1_shin_left"  body2="p1_foot_left"/>
    <exclude body1="p1_shin_right" body2="p1_foot_right"/>
    <exclude body1="p2_shin_left"  body2="p2_foot_left"/>
    <exclude body1="p2_shin_right" body2="p2_foot_right"/>
    <!-- Head-torso self-collision -->
    <exclude body1="p1_torso" body2="p1_head"/>
    <exclude body1="p2_torso" body2="p2_head"/>
    <!-- P1 kol -->
    <exclude body1="p1_torso"           body2="p1_right_upper_arm"/>
    <exclude body1="p1_torso"           body2="p1_left_upper_arm"/>
    <exclude body1="p1_right_upper_arm" body2="p1_forearm_right"/>
    <exclude body1="p1_left_upper_arm"  body2="p1_forearm_left"/>
    <exclude body1="p1_forearm_right"   body2="p1_fist_right"/>
    <exclude body1="p1_forearm_left"    body2="p1_fist_left"/>

    <!-- P2 kol -->
    <exclude body1="p2_torso"           body2="p2_right_upper_arm"/>
    <exclude body1="p2_torso"           body2="p2_left_upper_arm"/>
    <exclude body1="p2_right_upper_arm" body2="p2_forearm_right"/>
    <exclude body1="p2_left_upper_arm"  body2="p2_forearm_left"/>
    <exclude body1="p2_forearm_right"   body2="p2_fist_right"/>
    <exclude body1="p2_forearm_left"    body2="p2_fist_left"/>
  </contact>

  <!-- ─────────────────────────────────────────────── -->
  <!--  Actuators: 8 kol + 12 bacak = 20 (ankle pasif — actuator yok)  -->
  <!-- ─────────────────────────────────────────────── -->
  <!--
    ACTUATOR TABLOSU (16 toplam, 8/oyuncu):
    ─────────────────────────────────────────────────
    Kol   : shoulder ×2, elbow ×2   gear 150/100  (öncekiyle aynı)
    Bacak : hip_y    ×2, knee  ×2   gear 200/150  (yeni eklendi)
    ─────────────────────────────────────────────────
    Hip gear=200 : kalça, ağırlık merkezini taşıdığından daha fazla tork
    Knee gear=150: diz, kalçadan az ama kollardan fazla
  -->
  <actuator>
    <!-- P1 kol -->
    <general name="p1_shoulder_right" joint="p1_shoulder_right" gear="150 0 0 0 0 0"/>
    <general name="p1_elbow_right"    joint="p1_elbow_right"    gear="100 0 0 0 0 0"/>
    <general name="p1_shoulder_left"  joint="p1_shoulder_left"  gear="150 0 0 0 0 0"/>
    <general name="p1_elbow_left"     joint="p1_elbow_left"     gear="100 0 0 0 0 0"/>

    <!-- P1 bacak -->
    <general name="p1_hip_x_left"     joint="p1_hip_x_left"     gear="120 0 0 0 0 0"/>
    <general name="p1_hip_y_left"     joint="p1_hip_y_left"     gear="200 0 0 0 0 0"/>
    <general name="p1_knee_left"      joint="p1_knee_left"      gear="150 0 0 0 0 0"/>
    <general name="p1_hip_x_right"    joint="p1_hip_x_right"    gear="120 0 0 0 0 0"/>
    <general name="p1_hip_y_right"    joint="p1_hip_y_right"    gear="200 0 0 0 0 0"/>
    <general name="p1_knee_right"     joint="p1_knee_right"     gear="150 0 0 0 0 0"/>
    <general name="p1_ankle_left"     joint="p1_ankle_left"     gear="80 0 0 0 0 0"/>
    <general name="p1_ankle_right"    joint="p1_ankle_right"    gear="80 0 0 0 0 0"/>
    <general name="p1_hip_z_left"     joint="p1_hip_z_left"     gear="120 0 0 0 0 0"/>
    <general name="p1_hip_z_right"    joint="p1_hip_z_right"    gear="120 0 0 0 0 0"/>
    <general name="p1_bel_z"            joint="p1_bel_z"            gear="150 0 0 0 0 0"/>
    <general name="p1_shoulder_x_left"  joint="p1_shoulder_x_left"  gear="120 0 0 0 0 0"/>
    <general name="p1_shoulder_x_right" joint="p1_shoulder_x_right" gear="120 0 0 0 0 0"/>

    <!-- P2 kol -->
    <general name="p2_shoulder_right" joint="p2_shoulder_right" gear="150 0 0 0 0 0"/>
    <general name="p2_elbow_right"    joint="p2_elbow_right"    gear="100 0 0 0 0 0"/>
    <general name="p2_shoulder_left"  joint="p2_shoulder_left"  gear="150 0 0 0 0 0"/>
    <general name="p2_elbow_left"     joint="p2_elbow_left"     gear="100 0 0 0 0 0"/>

    <!-- P2 bacak -->
    <general name="p2_hip_x_left"     joint="p2_hip_x_left"     gear="120 0 0 0 0 0"/>
    <general name="p2_hip_y_left"     joint="p2_hip_y_left"     gear="200 0 0 0 0 0"/>
    <general name="p2_knee_left"      joint="p2_knee_left"      gear="150 0 0 0 0 0"/>
    <general name="p2_hip_x_right"    joint="p2_hip_x_right"    gear="120 0 0 0 0 0"/>
    <general name="p2_hip_y_right"    joint="p2_hip_y_right"    gear="200 0 0 0 0 0"/>
    <general name="p2_knee_right"     joint="p2_knee_right"     gear="150 0 0 0 0 0"/>
    <general name="p2_ankle_left"     joint="p2_ankle_left"     gear="80 0 0 0 0 0"/>
    <general name="p2_ankle_right"    joint="p2_ankle_right"    gear="80 0 0 0 0 0"/>
